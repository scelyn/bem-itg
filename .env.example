# =============================================================================
# BEM ITG KOLEKTIVA — ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT store actual production credentials or private keys in this file.
# Copy this file to '.env' and fill in your actual Supabase credentials.
# =============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIGURATION (Prisma 6)
# -----------------------------------------------------------------------------
# 1. DATABASE_URL: Pooler connection (Session / Transaction mode via Supavisor / PgBouncer, port 6543)
#    Digunakan oleh aplikasi runtime Express untuk efisiensi koneksi pooling.
#    Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct database connection (Port 5432)
#    Digunakan khusus oleh Prisma CLI untuk eksekusi migrasi, DDL schema, dan administrasi database langsung.
#    Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# AUTENTIKASI & KEAMANAN SISTEM
# -----------------------------------------------------------------------------
# JWT Secret Key (Gunakan string acak minimal 32 karakter untuk enkripsi token otentikasi)
JWT_SECRET="kolektiva_bem_itg_jwt_secret_dev_key_2026_secure"
JWT_EXPIRES_IN="8h"

# Client Application URL (Untuk validasi CORS frontend)
CORS_ORIGIN="http://localhost:5173"
